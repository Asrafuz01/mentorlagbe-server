# Server
PORT=5000
CLIENT_URL=http://localhost:3000

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017
DB_NAME=mentorlagbedb

# Auth (use long random values in production)
JWT_SECRET=replace-with-a-long-random-secret
# Must match the client's BETTER_AUTH_SECRET so session cookies can be verified.
BETTER_AUTH_SECRET=replace-with-the-client-secret
# Only needed if the client uses a custom BetterAuth cookie prefix.
BETTER_AUTH_COOKIE_PREFIX=better-auth
# Local development only; ignored when NODE_ENV=production.
ALLOW_DEV_JWT_WITHOUT_SESSION=false

# Stripe
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_STUDENT_PRO_PRICE_ID=price_replace_me
STRIPE_TUTOR_PRO_PRICE_ID=price_replace_me
